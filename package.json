{
  "name": "@cazorlas/autodesk-cleaner",
  "version": "0.1.0",
  "description": "Safe Autodesk uninstaller for Windows (Revit, AutoCAD, Navisworks, Desktop Connector...) that keeps a fresh reinstall working: vendor uninstallers, dependency order, quarantine instead of delete, reinstall-readiness check.",
  "bin": {
    "autodesk-cleaner": "bin/autodesk-cleaner.js"
  },
  "files": [
    "bin/",
    "src/",
    "AutodeskCleaner.ps1",
    "Start-AutodeskCleaner.bat",
    "README.md",
    "LICENSE"
  ],
  "os": [
    "win32"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "autodesk",
    "revit",
    "autocad",
    "navisworks",
    "uninstall",
    "uninstaller",
    "windows",
    "powershell"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cazorlas/Autodesk-uninstall.git"
  },
  "license": "GPL-3.0-only",
  "publishConfig": {
    "access": "public"
  }
}
